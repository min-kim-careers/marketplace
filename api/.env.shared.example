DB_USER=marketplace
DB_PASSWORD=change-me          # must match POSTGRES_PASSWORD
DB_NAME=marketplace
CACHE_PASSWORD=change-me       # must match REDIS_PASSWORD
CACHE_PORT=6379
CACHE_DB=0
SERVICE_KEY=change-me          # shared secret between web and api
SERVICE_KEY_HEADER=x-api-key
SESSION_HEADER=x-session
NONCE_SECRET=change-me
NONCE_LIFETIME_MINUTES=5
CONTAINER_IMAGE_DIR=/images
FRONTEND_IMAGE_BASE=http://localhost:8080/images
