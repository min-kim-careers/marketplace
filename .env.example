# Copy to .env and fill in. This is the only env file; compose passes these
# values to each service. For prod, keep a separate .env.prod and run:
#   docker compose -f compose.prod.yml --env-file .env.prod up -d

# Dev only: the host you open the app on (e.g. your LAN IP)
PUBLIC_HOST=localhost

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Shared secret between web and api
SERVICE_KEY=change-me
NONCE_SECRET=change-me

# Cloudflare Turnstile secret key and site key
CF_TURNSTILE_SECRET=
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=
# Firebase console > Project settings > Your apps > apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Admin: save the service-account JSON (Firebase console > Project settings >
# Service accounts > Generate new private key) as api/firebase-service-account.json
