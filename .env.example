# Copy to .env and fill in. Used by compose.dev.yml / compose.prod.yml.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketplace
REDIS_PASSWORD=change-me
NEXT_PUBLIC_SITE_KEY=          # Cloudflare Turnstile site key
NEXT_PUBLIC_FIREBASE_API_KEY=  # Firebase web API key
# Service env files also required (copy each *.example):
#   api/.env.shared  api/.env.cloudflare  web/.env.shared  gateway/.env.shared
# Firebase: save the service-account JSON (Firebase console > Project settings >
# Service accounts > Generate new private key) as api/firebase-service-account.json
