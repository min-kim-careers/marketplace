#!/bin/bash

EMAIL="test@test.com"

# Get the user ID from auth-db
USER_ID=$(docker exec -i auth-db-container \
  psql -U authdbuser -d authdb -t -c \
  "SELECT id FROM users WHERE email = '${EMAIL}';" | xargs)

if [ -z "$USER_ID" ]; then
  echo "User not found for email: $EMAIL"
  exit 1
fi

echo "Deleting profile for user_id: $USER_ID"

# Delete profile from api-db
docker exec -i api-db-container \
  psql -U apidbuser -d apidb -c \
  "DELETE FROM profiles WHERE user_id = '${USER_ID}';"

# Delete refresh tokens
docker exec -i auth-db-container \
  psql -U authdbuser -d authdb -c \
  "DELETE FROM refresh_tokens WHERE user_id = '${USER_ID}';"

# Delete user from auth-db
docker exec -i auth-db-container \
  psql -U authdbuser -d authdb -c \
  "DELETE FROM users WHERE id = '${USER_ID}';"

echo "Cleanup completed for $EMAIL"
