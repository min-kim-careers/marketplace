version: 1

formatters:
  precise:
    
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'
    

handlers:


  console:
    class: logging.StreamHandler
    formatter: precise

loggers:
  synapse.http.client:
    level: INFO
    handlers: [console]
  synapse.http.matrixfederationclient:
    level: INFO
    handlers: [console]
  synapse.http.matrixfederationclient.worker:
    level: INFO
    handlers: [console]
  synapse.http.matrixfederationclient.worker.federation:
    level: INFO
    handlers: [console]
  synapse.http.matrixfederationclient.worker.federation.client:
    level: INFO
    handlers: [console]
  synapse.http.matrixfederationclient.worker.federation.client.server:
    level: INFO
    handlers: [console]
  synapse.http.server:
    level: ERROR
    handlers: [console]

root:
  level: WARNING
  handlers: [console]

disable_existing_loggers: false
